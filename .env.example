# Copy to .env and fill in. Never commit or share .env or the *.session file:
# together they give full access to your Telegram account.

# From https://my.telegram.org -> "API development tools"
TG_API_ID=
TG_API_HASH=

# Bot or chat that answers a DOI with a PDF: @username or numeric chat ID
TG_TARGET=@your_bot

# Optional (defaults shown). Relative paths are relative to this file.
# OUTPUT_DIR=papers
# TG_SESSION=doi_downloader
# RESPONSE_TIMEOUT=180      # seconds to wait for a PDF per DOI
# POLL_INTERVAL=3           # seconds between checks for new messages
# PAUSE_BETWEEN_DOIS=3      # seconds between two requests
